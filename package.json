{
  "name": "scraper-challenge",
  "version": "0.1.0",
  "private": true,
  "description": "Scraper de jurisprudencia del Poder Judicial del Perú (TypeScript, sin navegador)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
